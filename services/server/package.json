{
  "name": "@kangxi/server",
  "version": "0.1.2",
  "type": "module",
  "private": true,
  "description": "KangXi.exe universal self-hosted backend server (Node 24 + built-in SQLite + WebSocket)",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "kangxi-server": "./dist/cli.js"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kangxi/protocol": "workspace:*",
    "@kangxi/server-core": "workspace:*",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
