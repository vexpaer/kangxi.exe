# KangXi.exe Backend Configuration
# Copy to .env and change KANGXI_PASSWORD before starting.

# Public port exposed on the server
KANGXI_PORT=8787

# Admin account used by Windows / Android clients to sign in
KANGXI_USERNAME=admin
KANGXI_PASSWORD=change-me-strong-password
KANGXI_OWNER_NAME=康熙

# Optional: set to 1 once to reset an existing database's admin password from KANGXI_PASSWORD
# KANGXI_RESET_PASSWORD=0

# Optional: only needed when using docker-compose.caddy.yml for automatic HTTPS
# KANGXI_DOMAIN=kangxi.example.com
